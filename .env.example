# Uso local apenas. No Railway, defina DATABASE_URL como uma referência ao
# serviço PostgreSQL (por exemplo: ${{Postgres.DATABASE_URL}}); não use localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omega_ecommerce
PORT=3000

# Opcional: banco do DW que contém filial.dcliente para consulta em tempo real.
# Não aponte esta variável para o PostgreSQL vazio da própria aplicação.
SOURCE_DATABASE_URL=
SOURCE_SCHEMA=filial

# Em Railway normalmente a conexão interna não exige SSL.
# PGSSLMODE=require
