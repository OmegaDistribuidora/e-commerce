# Railway fornece DATABASE_URL automaticamente ao adicionar PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omega_ecommerce
PORT=3000
VITE_PORT=5173

# Opcional: PostgreSQL do DW que contém filial.dcliente para consulta em tempo real.
SOURCE_DATABASE_URL=
SOURCE_SCHEMA=filial

# Em Railway normalmente a conexão interna não exige SSL.
# PGSSLMODE=require
