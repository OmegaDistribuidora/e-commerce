# Uso local apenas. No Railway, defina DATABASE_URL como uma referência ao
# serviço PostgreSQL (por exemplo: ${{Postgres.DATABASE_URL}}); não use localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omega_ecommerce
PORT=3000

# Supabase é usado exclusivamente para autenticação. A chave publishable pode
# existir no frontend; nunca use a secret/service_role em variáveis VITE_*.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: banco do DW que contém filial.dcliente para consulta em tempo real.
# Não aponte esta variável para o PostgreSQL vazio da própria aplicação.
SOURCE_DATABASE_URL=
SOURCE_SCHEMA=filial

# Conta administrativa inicial. Em produção, defina ADMIN_PASSWORD no Railway.
ADMIN_EMAIL=admin@omegadistribuidora.com.br
ADMIN_NAME=Administrador Ômega
ADMIN_PASSWORD=

# Token longo e aleatório compartilhado somente com a Connection ecommerce_api do Airflow.
PRODUCT_SYNC_TOKEN=
# Proteção contra cargas vazias ou parciais.
PRODUCT_SYNC_MIN_COUNT=100

# Consulta server-to-server do status dos pedidos WinThor. Nunca exponha a chave no Vite/navegador.
OMEGA_API_URL=https://apiomega.williamfmarinho.com.br
OMEGA_API_KEY=
ORDER_STATUS_CACHE_MINUTES=15

# Em Railway normalmente a conexão interna não exige SSL.
# PGSSLMODE=require
